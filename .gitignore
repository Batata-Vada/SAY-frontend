# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Share safe example values, but never live environment files
!.env.example
!.env.*.example

# Local editors, caches and test reports
.vscode/
.idea/
.turbo/
.cache/
.eslintcache
/next-env.d.ts
/playwright-report/
/test-results/
/storybook-static/
.npm/
.pnpm-store/
*.log
*.swp
*.swo
*~
Thumbs.db

# Local data, export dumps and credentials
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.key
*.p12
*.pfx
.envrc
.direnv/
/public/uploads/
